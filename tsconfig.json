{
  "compilerOptions": {
    "target": "es2016", 
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",
    "noEmitOnError": true, 
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  }
}
